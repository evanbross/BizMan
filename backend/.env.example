# Copy to backend/.env for local dev. Values below match the Supabase CLI's local stack defaults
# (`npx supabase status` after `npx supabase start` prints the real local values).

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
