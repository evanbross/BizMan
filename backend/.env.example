# Copy to backend/.env for local dev. Values below match the Supabase CLI's local stack defaults
# (`npx supabase status` after `npx supabase start` prints the real local values).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Named, fixed ports (not FastAPI's/Vite's 8000/5173 defaults) so this project never collides
# with another local project's dev servers - see AGENTS.md "Local Caddy registration".
BACKEND_PORT=8610
FRONTEND_PORT=8611

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
